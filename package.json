{
  "name": "gurukrupan-agl",
  "version": "0.1.0",
  "private": true,
  "description": "Minimal React and Electron desktop application.",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=20.0.0 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "electron": "wait-on tcp:5173 && electron .",
    "dev:desktop": "concurrently -k \"npm run dev\" \"npm run electron\"",
    "build": "vite build",
    "start": "electron ."
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^10.0.0",
    "electron": "^44.4.3",
    "vite": "^6.3.5",
    "wait-on": "^9.0.0"
  }
}
